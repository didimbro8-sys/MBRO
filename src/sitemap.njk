---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
publie: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in collections.all %}{% if p.data.robots != "noindex" and p.url and not p.url.endsWith(".xml") and not p.url.endsWith(".txt") %}
  <url><loc>{{ site.url }}{{ p.url }}</loc><lastmod>{{ p.date | iso }}</lastmod></url>
{%- endif %}{% endfor %}
</urlset>
