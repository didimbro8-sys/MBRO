<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
{%- set pageTitre = (titre_seo or (title + " | " + site.agence)) if title else (site.nom + " · " + site.titre_hero + " | " + site.agence + " " + site.ville) %}
{%- set pageDesc = description or resume or (site.nom + ", fondateur d'" + site.agence + " à " + site.ville + " : communication des organisations, stratégie digitale, création de contenu, community management et branding. Portfolio et études de cas.") %}
{%- set pageUrl = site.url + page.url %}
{%- set cover = couverture | localUrl %}
{%- set pageImage = (site.url + cover) if (cover and cover.startsWith("/")) else (site.url + "/assets/img/og-image.png") %}
<title>{{ pageTitre }}</title>
<meta name="description" content="{{ pageDesc }}">
<meta name="author" content="{{ site.nom }}">
<meta name="robots" content="{{ robots or 'index, follow, max-image-preview:large' }}">
<link rel="canonical" href="{{ pageUrl }}">
<meta name="theme-color" content="#300024">
<meta property="og:type" content="{{ og_type or 'website' }}">
<meta property="og:locale" content="fr_CI">
<meta property="og:site_name" content="{{ site.agence }}">
<meta property="og:title" content="{{ pageTitre }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ pageUrl }}">
<meta property="og:image" content="{{ pageImage }}">
<meta property="og:image:alt" content="{{ couverture_alt or (site.agence + ', portfolio du fondateur, ' + site.ville) }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.png" type="image/png">
<link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="alternate" type="application/atom+xml" title="Journal {{ site.agence }}" href="/journal/flux.xml">
<link rel="preload" href="/assets/fonts/montserrat-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ '/assets/css/style.css' | v }}">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person", "@id": "{{ site.url }}/#moi", "name": {{ site.nom | json | safe }},
      "jobTitle": {{ site.titre_pro | json | safe }}, "url": "{{ site.url }}/",
      "address": { "@type": "PostalAddress", "addressLocality": {{ site.ville | json | safe }}, "addressCountry": "CI" },
      "worksFor": { "@id": "{{ site.url }}/#agence" },
      "knowsAbout": ["Communication des organisations", "Communication interne", "Communication institutionnelle", "Stratégie digitale", "Community management", "Création de contenu", "Publicité en ligne", "Branding"],
      "sameAs": [{{ site.facebook | safeUrl | json | safe }}, {{ site.instagram | safeUrl | json | safe }}, {{ site.tiktok | safeUrl | json | safe }}{% if site.linkedin | safeUrl %}, {{ site.linkedin | safeUrl | json | safe }}{% endif %}]
    },
    {
      "@type": "ProfessionalService", "@id": "{{ site.url }}/#agence", "name": {{ site.agence | json | safe }},
      "slogan": {{ site.slogan | json | safe }}, "url": "{{ site.url }}/", "logo": "{{ site.url }}/assets/uploads/am-digital-logo.jpg",
      "telephone": {{ site.telephone | json | safe }}, "founder": { "@id": "{{ site.url }}/#moi" },
      "address": { "@type": "PostalAddress", "addressLocality": {{ site.ville | json | safe }}, "addressCountry": "CI" },
      "areaServed": { "@type": "Country", "name": "Côte d'Ivoire" }
    }{% if schema_page %},
    {{ schema_page | safe }}{% endif %}
  ]
}
</script>
<script src="/assets/js/vendor/gsap.min.js" defer></script>
<script src="/assets/js/vendor/ScrollTrigger.min.js" defer></script>
<script src="{{ '/assets/js/main.js' | v }}" defer></script>
{%- for s in page_scripts %}
<script src="{{ s | v }}" defer></script>
{%- endfor %}
</head>
{%- set rub = 'accueil' if page.url == '/' else ('realisations' if page.url and page.url.startsWith('/realisations/') else ('veille' if page.url and page.url.startsWith('/veille/') else ('journal' if page.url and page.url.startsWith('/journal/') else 'autre'))) %}
<body>
<a class="skip" href="#contenu">Aller au contenu</a>
<div class="cursor" id="cursor" aria-hidden="true"></div>

<header class="nav g" id="nav">
  <div class="in">
    <a class="brand" href="/" aria-label="{{ site.agence }}, accueil"><img src="/assets/uploads/am-digital-logo.jpg" alt="Logo {{ site.agence }}" width="44" height="44"><span>M'BRO <b>Israël</b></span></a>
    <nav aria-label="Navigation principale">
      <ul>
        {%- for l in [["realisations","/#realisations","Réalisations"],["methode","/#methode","Méthode"],["veille","/veille/","Veille"],["journal","/journal/","Journal"]] %}
        <li><a href="{{ l[1] }}"{% if rub == l[0] %} aria-current="page"{% endif %}>{{ l[2] }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
    <a class="pill gold mag" href="/#contact">Me contacter</a>
  </div>
</header>

<main id="contenu">
{{ content | safe }}
</main>

<footer class="foot g"><div class="in"><span>© 2026 {{ site.nom }} · {{ site.agence }}, {{ site.ville }}</span><span><a href="/journal/flux.xml">Flux du Journal</a> · <a href="/mentions-legales/">Mentions légales</a></span></div></footer>

<dialog class="lightbox" id="lightbox" aria-label="Visuel agrandi">
  <form method="dialog"><button class="round close" aria-label="Fermer">×</button></form>
  <img id="lightbox-img" src="data:," alt="">
</dialog>
</body>
</html>
