{#- Assistant du site : réponses préparées à partir du contenu publié (aucune IA, aucun service tiers, rien n'est enregistré).
    Chaque <template> est une réponse ; data-k liste les mots qui la déclenchent quand le visiteur écrit sa question. -#}
{%- set vedette = (collections.aLaUne | first) if collections.aLaUne.length else (collections.realisations | first) %}
{%- set derniere = collections.veille | first %}
{%- set wa = "https://wa.me/" + (site.whatsapp | replace(r/[^0-9]/g, "")) %}
<div class="assistant" id="assistant" data-wa="{{ wa | safeUrl }}">
  <button type="button" class="assistant-toggle magnet" aria-expanded="false" aria-controls="assistant-panel">
    <span class="assistant-dot" aria-hidden="true"></span><span class="assistant-label">Une question ?</span>
  </button>
  <section class="assistant-panel" id="assistant-panel" aria-label="Assistant du site" hidden>
    <header class="assistant-head">
      {%- if site.photo | localUrl %}<img src="{{ site.photo | localUrl }}" alt="" width="40" height="40">{% endif %}
      <div><strong>Assistant du site</strong><span>Réponses préparées par {{ site.nom | todo | safe }}</span></div>
      <button type="button" class="assistant-close" aria-label="Fermer l'assistant">×</button>
    </header>
    <div class="assistant-log" role="log" aria-live="polite">
      <div class="msg bot"><p>Bonjour ! Je vous présente le parcours, les réalisations et les services de {{ site.nom | todo | safe }}. Choisissez une question ou écrivez la vôtre.</p></div>
    </div>
    <div class="assistant-chips"></div>
    <form class="assistant-form" autocomplete="off">
      <label class="sr" for="assistant-q">Votre question</label>
      <input id="assistant-q" name="q" type="text" maxlength="160" placeholder="Écrivez votre question…">
      <button type="submit" class="btn btn-gold">Envoyer</button>
    </form>
  </section>

  <template data-q="Qui est {{ site.nom.split(' ')[1] or site.nom }} ?" data-k="qui,profil,presente,présente,parcours,diplome,diplôme,master,formation,experience,expérience,cv">
    <p><strong>{{ site.nom | todo | safe }}</strong>, {{ site.titre_pro | lower }} à {{ site.ville }}.</p>
    {% for p in profil.paragraphes.slice(0, 2) %}<p>{{ p }}</p>{% endfor %}
    <p><a href="/#profil">Voir son profil et son parcours</a></p>
  </template>

  <template data-q="Quelles sont ses réalisations ?" data-k="realisation,réalisation,projet,etude,étude,cas,portfolio,travaux,osep,exemple">
    <p>{{ collections.realisations.length }} étude{% if collections.realisations.length > 1 %}s{% endif %} de cas publiée{% if collections.realisations.length > 1 %}s{% endif %} :</p>
    <ul>{% for r in collections.realisations %}<li><a href="{{ r.url }}">{{ r.data.title }}</a></li>{% endfor %}</ul>
  </template>

  {%- if vedette and vedette.data.resultats and vedette.data.resultats.length %}
  <template data-q="Quels résultats a-t-il obtenus ?" data-k="resultat,résultat,chiffre,kpi,performance,impact,portee,portée,engagement">
    <p>Sur « {{ vedette.data.title }} » :</p>
    <ul>{% for r in vedette.data.resultats %}<li><strong>{{ r.valeur | todo | safe }}</strong> {{ r.indicateur | todo | safe }}</li>{% endfor %}</ul>
    <p><a href="{{ vedette.url }}">Lire l'étude de cas</a></p>
  </template>
  {%- endif %}

  <template data-q="Que propose {{ site.agence }} ?" data-k="service,propose,offre,agence,am.digital,amdigital,prix,tarif,devis,prestation,community,branding,publicite,publicité">
    <p>{{ site.agence }} accompagne les entreprises d'{{ site.ville }} sur cinq services : stratégie digitale, création de contenu, community management, publicité en ligne, branding et identité visuelle.</p>
    <p>Pour un devis, le plus rapide est WhatsApp : <a href="{{ wa | safeUrl }}" rel="noopener noreferrer" target="_blank">{{ site.telephone_affiche }}</a>.</p>
  </template>

  <template data-q="Est-il disponible ?" data-k="disponible,disponibilite,disponibilité,recrut,poste,emploi,embauche,stage,freelance,mission,cdi,cdd">
    <p>Oui. {{ site.nom | todo | safe }} est ouvert à :</p>
    <ul>{% for d in site.disponibilites %}<li>{{ d }}</li>{% endfor %}</ul>
    <p><a href="/#contact">Lui proposer un poste ou une mission</a></p>
  </template>

  {%- if derniere %}
  <template data-q="Que dit la dernière veille ?" data-k="veille,tendance,actualite,actualité,ia,news,nouveaute,nouveauté,signal">
    <p>Veille du {{ derniere.date | dateFr }} : <strong>{{ derniere.data.title }}</strong>.</p>
    {% if derniere.data.signaux %}<ul>{% for s in derniere.data.signaux %}<li>{{ s.titre }}</li>{% endfor %}</ul>{% endif %}
    <p><a href="{{ derniere.url }}">Lire la veille complète</a></p>
  </template>
  {%- endif %}

  <template data-q="Comment le contacter ?" data-k="contact,contacter,joindre,telephone,téléphone,whatsapp,mail,email,e-mail,appeler,ecrire,écrire,rdv,rendez">
    <p>WhatsApp ou téléphone : <a href="{{ wa | safeUrl }}" rel="noopener noreferrer" target="_blank">{{ site.telephone_affiche }}</a></p>
    <p>E-mail : <span class="mail-js" data-u="{{ site.email_nom }}" data-d="{{ site.email_domaine }}">{{ site.email_nom }} [at] {{ site.email_domaine }}</span></p>
    <p>Ou le <a href="/#contact">formulaire de contact</a>. Réponse sous 24 heures ouvrées.</p>
  </template>

  <template data-fallback>
    <p>Je n'ai pas de réponse préparée à cette question. {{ site.nom | todo | safe }} vous répond directement sur <a href="{{ wa | safeUrl }}" rel="noopener noreferrer" target="_blank">WhatsApp</a> ou par le <a href="/#contact">formulaire</a>.</p>
  </template>
</div>
