---
layout: base.njk
og_type: article
---
{#- Étude de cas : en-tête, fiche, contexte/objectif, dispositif, résultats, récit, galerie, enseignement. -#}
<section class="case-hero g" aria-labelledby="t-case">
  <div class="aurora" aria-hidden="true"><i class="b1"></i><i class="b2"></i><i class="b3"></i></div>
  <div class="in">
    <p class="crumb"><a href="/">Accueil</a><span aria-hidden="true">/</span><a href="/#realisations">Réalisations</a><span aria-hidden="true">/</span><span>Étude de cas</span></p>
    <h1 id="t-case" aria-label="{{ title }}"><span aria-hidden="true">{% for w in title.split(" ") %}<span class="w"><span data-split>{{ w }}</span></span> {% endfor %}</span></h1>
    <p class="lead">{{ resume | todo | safe }}</p>
    <ul class="tags"><li>{{ nature }}</li>{% for c in categories %}<li>{{ c }}</li>{% endfor %}</ul>
    {% if couverture | localUrl %}<figure class="cover{% if not couverture_paysage %} portrait-mode{% endif %}"><img src="{{ couverture | localUrl }}" alt="{{ couverture_alt }}" width="1200" height="700" fetchpriority="high"></figure>{% endif %}
    <dl class="fiche">
      {% if client %}<div><dt>Client</dt><dd>{{ client | todo | safe }}</dd></div>{% endif %}
      <div><dt>Période</dt><dd><time datetime="{{ page.date | iso }}">{{ date | moisAnnee }}</time></dd></div>
      {% if role %}<div><dt>Mon rôle</dt><dd>{{ role | todo | safe }}</dd></div>{% endif %}
      {% if canaux and canaux.length %}<div><dt>Canaux</dt><dd>{{ canaux | join(", ") }}</dd></div>{% endif %}
    </dl>
  </div>
</section>

<section class="case-sec g" aria-label="Contexte et objectif">
  <div class="in duo">
    <article><span class="num">01</span><h2>Contexte</h2><p>{{ contexte | todo | safe }}</p></article>
    <article><span class="num">02</span><h2>Objectif</h2><p>{{ objectif | todo | safe }}</p></article>
  </div>
</section>

{%- if dispositif and dispositif.length %}
<section class="case-sec g" aria-labelledby="t-disp">
  <div class="in">
    <div class="sec-head"><span class="lbl">Ce qui a été mis en place</span><h2 id="t-disp" class="rv">Le <span class="or">dispositif</span></h2></div>
    <ol class="dispositif">{% for d in dispositif %}<li>{{ d | todo | safe }}</li>{% endfor %}</ol>
  </div>
</section>
{%- endif %}

{%- if resultats and resultats.length %}
<section class="case-sec results g" aria-labelledby="t-res">
  <div class="in">
    <div class="sec-head"><span class="lbl">Ce que le projet a produit</span><h2 id="t-res" class="rv">Résultats</h2></div>
    <div class="stat-grid">
      {%- for r in resultats %}
      {%- set nombre = r.valeur | string | replace(r/[^0-9]/g, "") %}
      <div class="stat"><strong{% if nombre %} data-count="{{ nombre }}"{% if "%" in r.valeur %} data-suffix=" %"{% endif %}{% endif %}>{{ r.valeur }}</strong><span>{{ r.indicateur }}</span></div>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endif %}

{%- if content | trim %}
<section class="case-sec g" aria-labelledby="t-story">
  <div class="in story">
    <div class="sec-head"><span class="lbl">Le récit du projet</span><h2 id="t-story" class="rv">Dans les <span class="or">coulisses</span></h2></div>
    <div class="story-body prose">{{ content | todoHtml | safe }}</div>
  </div>
</section>
{%- endif %}

{%- if galerie and galerie.length %}
<section class="case-sec g" aria-labelledby="t-gal">
  <div class="in">
    <div class="sec-head"><span class="lbl">{{ galerie.length }} visuels · touchez une image pour l'agrandir</span><h2 id="t-gal" class="rv">Galerie</h2></div>
    <div class="mosaic">
      {%- for g in galerie %}
      {%- if g.video | localUrl %}
      <figure class="shot-btn"><video src="{{ g.video | localUrl }}"{% if g.image | localUrl %} poster="{{ g.image | localUrl }}"{% endif %} controls playsinline preload="none"></video><span>{{ g.legende }}</span></figure>
      {%- elif g.lien | safeUrl and not (g.image | localUrl) %}
      <a class="shot-btn" href="{{ g.lien | safeUrl }}" rel="noopener noreferrer" target="_blank"><span>{{ g.legende }}</span></a>
      {%- elif g.image | localUrl %}
      <button class="shot-btn" type="button" data-full="{{ g.image | localUrl }}"><img src="{{ g.image | localUrl }}" alt="{{ g.legende }}" loading="lazy"><span>{{ g.legende }}</span></button>
      {%- endif %}
      {%- endfor %}
    </div>
  </div>
</section>
{%- endif %}

{%- if enseignement %}
<section class="lesson g" aria-label="Ce que j'en retiens">
  <div class="in"><span class="lbl">Ce que j'en retiens</span><blockquote class="rv">{{ enseignement | todo | safe }}</blockquote></div>
</section>
{%- endif %}

{%- set prev = collections.realisations | getPreviousCollectionItem(page) %}{% set next = collections.realisations | getNextCollectionItem(page) %}
<section class="case-sec g" aria-label="Navigation entre études de cas">
  <div class="in"><nav class="pager" aria-label="Autres études de cas">
    {% if prev %}<a class="prev" href="{{ prev.url }}">{% if prev.data.couverture | localUrl %}<img src="{{ prev.data.couverture | localUrl }}" alt="" width="96" height="96" loading="lazy">{% endif %}<span><small>← Plus récente</small><b>{{ prev.data.title }}</b></span></a>{% else %}<span></span>{% endif %}
    {% if next %}<a class="next" href="{{ next.url }}">{% if next.data.couverture | localUrl %}<img src="{{ next.data.couverture | localUrl }}" alt="" width="96" height="96" loading="lazy">{% endif %}<span><small>Plus ancienne →</small><b>{{ next.data.title }}</b></span></a>{% else %}<span></span>{% endif %}
  </nav></div>
</section>

<section class="mini-cta g" aria-labelledby="t-cta">
  <div class="in"><h2 id="t-cta">Vous cherchez un <span class="or">nouveau talent ?</span></h2><a class="pill gold mag" href="/#contact">Discutons de votre projet</a></div>
</section>
