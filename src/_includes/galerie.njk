{#- Galerie : chaque image s'agrandit au clic. Une entrée avec « video » affiche le lecteur, avec « lien » ouvre la publication. -#}
<ul class="galerie">
  {%- for g in items %}
  {%- set img = g.image | localUrl %}{% set vid = g.video | localUrl %}{% set lien = g.lien | safeUrl %}
  {%- if img or vid %}
  <li>
    <figure>
      {%- if vid %}
      <video src="{{ vid }}" {% if img %}poster="{{ img }}" {% endif %}controls preload="none" playsinline></video>
      {%- else %}
      <button type="button" class="zoom" data-src="{{ img }}" data-legende="{{ g.legende }}" aria-label="Agrandir : {{ g.legende }}"><img src="{{ img }}" alt="{{ g.legende }}" loading="lazy" decoding="async"></button>
      {%- endif %}
      <figcaption>{{ g.legende }}{% if lien %} <a href="{{ lien }}" rel="noopener noreferrer" target="_blank">Voir la publication <span aria-hidden="true">↗</span></a>{% endif %}</figcaption>
    </figure>
  </li>
  {%- endif %}
  {%- endfor %}
</ul>
