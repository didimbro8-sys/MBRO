---
layout: base.njk
og_type: article
---
{#- Une édition de la veille : signaux (fait, décryptage, décision, source), analyse, visuel publié. -#}
{%- from "hero.njk" import hero %}
{%- set fb = lien_facebook | safeUrl %}{% set ig = lien_instagram | safeUrl %}
{{ hero('<a href="/">Accueil</a><span aria-hidden="true">/</span><a href="/veille/">Veille stratégique</a>', 'La Veille ' + site.agence + ' <span>·</span> <time datetime="' + (page.date | iso) + '">' + (page.date | dateFr) + '</time>', title, resume, title.length > 60) }}
<section class="case-sec g" aria-label="Les signaux">
  <div class="in v-layout">
    <div>
      <ol class="signaux">
        {%- for s in signaux %}
        <li class="signal"><span class="sn" aria-hidden="true">{{ loop.index | pad }}</span><div>
          {% if s.rubrique %}<span class="cat">{{ s.rubrique }}</span>{% endif %}
          <h2>{{ s.titre }}</h2>
          {% if s.decryptage %}<p>{{ s.decryptage }}</p>{% endif %}
          {% if s.decision %}<p class="decision"><b>Décision pour votre entreprise</b>{{ s.decision }}</p>{% endif %}
          {% if s.source %}<p class="src">Source : {{ s.source }}</p>{% endif %}
        </div></li>
        {%- endfor %}
      </ol>
      {% if content | trim %}<div class="analyse"><div class="prose">{{ content | safe }}</div></div>{% endif %}
      <p class="signature">{{ site.nom }}, fondateur d'{{ site.agence }}</p>
      {% if fb or ig %}<p class="row-links">{% if fb %}<a class="pill ghost" href="{{ fb }}" rel="noopener noreferrer" target="_blank">Voir sur Facebook</a>{% endif %}{% if ig %}<a class="pill ghost" href="{{ ig }}" rel="noopener noreferrer" target="_blank">Voir sur Instagram</a>{% endif %}</p>{% endif %}
    </div>
    {% if couverture | localUrl %}<figure class="v-visual"><button class="shot-btn" type="button" data-full="{{ couverture | localUrl }}"><img src="{{ couverture | localUrl }}" alt="{{ couverture_alt }}" width="1080" height="1350"><span>Le visuel publié sur les réseaux · touchez pour agrandir</span></button></figure>{% endif %}
  </div>
</section>
{%- set prev = collections.veille | getPreviousCollectionItem(page) %}{% set next = collections.veille | getNextCollectionItem(page) %}
<section class="case-sec g" aria-label="Autres veilles">
  <div class="in">
  <nav class="pager" aria-label="Autres veilles">
    {% if prev %}<a class="prev" href="{{ prev.url }}">{% if prev.data.couverture | localUrl %}<img src="{{ prev.data.couverture | localUrl }}" alt="" width="96" height="96" loading="lazy">{% endif %}<span><small>← Plus récente</small><b>{{ prev.data.title }}</b></span></a>{% else %}<span></span>{% endif %}
    {% if next %}<a class="next" href="{{ next.url }}">{% if next.data.couverture | localUrl %}<img src="{{ next.data.couverture | localUrl }}" alt="" width="96" height="96" loading="lazy">{% endif %}<span><small>Plus ancienne →</small><b>{{ next.data.title }}</b></span></a>{% else %}<span></span>{% endif %}
  </nav>
  <p class="row-links end"><a class="pill ghost" href="/veille/">Toutes les veilles</a></p>
  </div>
</section>
{% include "mini-cta.njk" %}
