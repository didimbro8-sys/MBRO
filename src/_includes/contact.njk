{#- Contact : une carte plein écran, l'e-mail en très grand (assemblé par le script), puis le formulaire -#}
<section class="contact" id="contact" aria-labelledby="ct-t">
  <div class="wrap">
    <div class="contact-card">
      <h2 id="ct-t" class="contact-t">Vous cherchez un nouveau talent ?</h2>
      <p class="contact-mail"><span id="email-slot" data-u="{{ site.email_nom }}" data-d="{{ site.email_domaine }}">{{ site.email_nom }} [at] {{ site.email_domaine }}</span></p>
      <ul class="contact-links">
        <li><a class="link-dot" href="https://wa.me/{{ site.whatsapp | replace(r/[^0-9]/g, "") }}" rel="noopener noreferrer" target="_blank"><span class="dot" aria-hidden="true"></span><span class="roll-box"><span class="roll-in">WhatsApp</span><span class="roll-in" aria-hidden="true">WhatsApp</span></span></a></li>
        {%- for r in [["LinkedIn",site.linkedin],["Facebook",site.facebook],["Instagram",site.instagram],["TikTok",site.tiktok]] %}{% if r[1] | safeUrl %}
        <li><a class="link-dot" href="{{ r[1] | safeUrl }}" rel="noopener noreferrer me" target="_blank"><span class="dot" aria-hidden="true"></span><span class="roll-box"><span class="roll-in">{{ r[0] }}</span><span class="roll-in" aria-hidden="true">{{ r[0] }}</span></span></a></li>
        {%- endif %}{% endfor %}
        {%- if profil.cv | localUrl %}<li><a class="link-dot" href="{{ profil.cv | localUrl }}"><span class="dot" aria-hidden="true"></span><span class="roll-box"><span class="roll-in">Télécharger mon CV</span><span class="roll-in" aria-hidden="true">Télécharger mon CV</span></span></a></li>{% endif %}
      </ul>
      <p class="contact-tel">{{ site.telephone_affiche }} · {{ site.ville }}, {{ site.pays }} · réponse sous 24 heures ouvrées</p>
      <details class="contact-more">
        <summary><span class="dot" aria-hidden="true"></span>Ou écrivez-moi directement ici</summary>
        <form class="contact-form" id="contact-form" action="https://api.web3forms.com/submit" method="POST" novalidate>
          <input type="hidden" name="access_key" value="{{ site.cle_formulaire }}">
          <input type="hidden" name="subject" value="Nouveau message depuis le portfolio {{ site.agence }}">
          <input type="hidden" name="redirect" value="{{ site.url }}/merci/">
          <div class="hp" aria-hidden="true"><label for="botcheck">Ne pas remplir</label><input type="checkbox" name="botcheck" id="botcheck" tabindex="-1" autocomplete="off"></div>
          <div class="row2">
            <div class="field"><label for="nom">Nom et organisation</label><input id="nom" name="name" type="text" required maxlength="120" autocomplete="name"></div>
            <div class="field"><label for="mail">E-mail</label><input id="mail" name="email" type="email" required maxlength="160" autocomplete="email"></div>
          </div>
          <div class="field"><label for="objet">Objet</label>
            <select id="objet" name="objet" required>
              <option value="Recrutement">Proposition de poste</option>
              <option value="Stage">Proposition de stage</option>
              <option value="Mission">Mission pour {{ site.agence }}</option>
              <option value="Autre">Autre demande</option>
            </select>
          </div>
          <div class="field"><label for="msg">Message</label><textarea id="msg" name="message" required minlength="20" maxlength="3000"></textarea></div>
          <label class="consent" for="rgpd"><input type="checkbox" id="rgpd" name="consentement" value="oui" required><span>J'accepte que mes informations servent uniquement à répondre à ma demande. Voir les <a class="form-link" href="/mentions-legales/">mentions légales</a>.</span></label>
          <button class="btn btn-gold magnet" type="submit">Envoyer le message</button>
          <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
        </form>
      </details>
    </div>
  </div>
</section>
