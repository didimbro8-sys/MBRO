{#- Contact : coordonnées et formulaire Web3Forms (clé dans « Réglages du site ») -#}
{%- set courriel = site.email_nom + "@" + site.email_domaine %}
<section class="cta g" id="contact" aria-labelledby="t-cta">
  <div class="in">
    <div class="cta-head">
      <span class="lbl">Vous cherchez un nouveau talent ?</span>
      <h2 id="t-cta" class="rv">Discutons de votre <span class="or">prochain projet</span></h2>
      <div class="contact-line">
        <span class="mail"><span id="mail">{{ courriel }}</span> <button class="copy" type="button" data-copy="mail">Copier</button></span>
        <a href="https://wa.me/{{ site.whatsapp | replace(r/[^0-9]/g, '') }}" rel="noopener noreferrer" target="_blank">WhatsApp {{ site.telephone_affiche }}</a>
        <span>Réponse sous 24 heures ouvrées</span>
      </div>
      <ul class="socials">
        {%- for r in [["Facebook",site.facebook],["Instagram",site.instagram],["TikTok",site.tiktok],["LinkedIn",site.linkedin]] %}{% if r[1] | safeUrl %}
        <li><a href="{{ r[1] | safeUrl }}" rel="noopener noreferrer me" target="_blank">{{ r[0] }}</a></li>
        {%- endif %}{% endfor %}
        {%- if profil.cv | localUrl %}<li><a href="{{ profil.cv | localUrl }}">Mon CV</a></li>{% endif %}
      </ul>
    </div>
    <form class="form" id="contact-form" action="https://api.web3forms.com/submit" method="POST" novalidate>
      <input type="hidden" name="access_key" value="{{ site.cle_formulaire }}">
      <input type="hidden" name="subject" value="Nouveau message depuis le portfolio {{ site.agence }}">
      <input type="hidden" name="redirect" value="{{ site.url }}/merci/">
      <input type="checkbox" name="botcheck" id="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <label for="nom">Votre nom et organisation</label>
      <input id="nom" name="name" type="text" required maxlength="120" autocomplete="name">
      <label for="mail-in">Votre e-mail</label>
      <input id="mail-in" name="email" type="email" required maxlength="160" autocomplete="email">
      <label for="objet">Objet</label>
      <select id="objet" name="objet" required>
        <option value="Recrutement">Proposition de poste</option>
        <option value="Stage">Proposition de stage</option>
        <option value="Mission">Mission pour {{ site.agence }}</option>
        <option value="Autre">Autre demande</option>
      </select>
      <label for="msg">Votre message</label>
      <textarea id="msg" name="message" required minlength="20" maxlength="3000" rows="5"></textarea>
      <label class="check"><input type="checkbox" id="rgpd" name="consentement" value="oui" required> J'accepte que mes données servent uniquement à me répondre (<a href="/mentions-legales/">mentions légales</a>).</label>
      <button class="pill gold mag" type="submit">Envoyer le message</button>
      <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>
