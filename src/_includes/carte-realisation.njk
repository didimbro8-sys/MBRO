{#- Carte d'une réalisation : grille d'un dossier de communication -#}
{%- set numero = collections.realisations | rang(item.url) %}
<article class="case">
  <div class="case-meta">
    <span class="num">{{ numero | pad }}</span>
    <h3><a class="case-link" href="{{ item.url }}">{{ item.data.title }}</a></h3>
    <div class="chips">
      <span class="chip{% if item.data.nature == 'Projet réel' %} real{% endif %}">{{ item.data.nature }}</span>
      {%- for c in item.data.categories %}<span class="chip">{{ c }}</span>{% endfor %}
    </div>
    {% if item.data.couverture | localUrl %}<span class="case-cover-wrap tilt"><img class="case-cover" src="{{ item.data.couverture | localUrl }}" alt="{{ item.data.couverture_alt }}" loading="lazy" width="640" height="400"></span>{% endif %}
  </div>
  <dl class="case-body">
    <div><dt>Contexte</dt><dd>{{ item.data.contexte | todo | safe }}</dd></div>
    <div><dt>Objectif</dt><dd>{{ item.data.objectif | todo | safe }}</dd></div>
    {% if item.data.dispositif and item.data.dispositif.length %}<div><dt>Dispositif</dt><dd><ul>{% for d in item.data.dispositif %}<li>{{ d | todo | safe }}</li>{% endfor %}</ul></dd></div>{% endif %}
    {%- if item.data.resultats and item.data.resultats.length %}
    <div><dt>Résultats</dt><dd><ul class="kpis">{% for r in item.data.resultats %}<li><strong>{{ r.valeur | todo | safe }}</strong><span>{{ r.indicateur | todo | safe }}</span></li>{% endfor %}</ul></dd></div>
    {%- elif item.data.resultats is undefined %}
    <div><dt>Résultats</dt><dd><span class="todo">résultats à publier</span></dd></div>
    {%- endif %}
    <div class="case-more"><dt></dt><dd><a href="{{ item.url }}">Lire l'étude de cas complète</a></dd></div>
  </dl>
</article>
