---
layout: base.njk
og_type: article
---
{#- Une note du Journal -#}
{%- from "hero.njk" import hero %}
{{ hero('<a href="/">Accueil</a><span aria-hidden="true">/</span><a href="/journal/">Journal</a>', 'Journal <span>·</span> <time datetime="' + (page.date | iso) + '">' + (page.date | dateFr) + '</time>', title, resume, title.length > 60) }}
<section class="case-sec g" aria-label="Article">
  <div class="in">
    {% if couverture | localUrl %}<figure class="article-cover"><img src="{{ couverture | localUrl }}" alt="{{ couverture_alt }}"></figure>{% endif %}
    <div class="prose article-body">{{ content | todoHtml | safe }}</div>
    <p class="signature">{{ site.nom }}, fondateur d'{{ site.agence }}</p>
    <p class="row-links end"><a class="pill ghost" href="/journal/">Toutes les notes</a><a class="pill ghost" href="/veille/">La veille stratégique</a></p>
  </div>
</section>
{% include "mini-cta.njk" %}
