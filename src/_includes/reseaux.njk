{#- Liens vers les réseaux sociaux : renseignés dans « Réglages du site ». Un réseau vide n'apparaît pas. -#}
{%- from "icones.njk" import icone -%}
<ul class="reseaux{% if variante %} reseaux--{{ variante }}{% endif %}" aria-label="Réseaux sociaux">
  {%- for r in [["facebook","Facebook",site.facebook],["instagram","Instagram",site.instagram],["tiktok","TikTok",site.tiktok],["linkedin","LinkedIn",site.linkedin]] %}
  {%- if r[2] | safeUrl %}
  <li><a href="{{ r[2] | safeUrl }}" rel="noopener noreferrer me" target="_blank" aria-label="{{ r[1] }} (nouvel onglet)">{{ icone(r[0]) | safe }}<span>{{ r[1] }}</span></a></li>
  {%- endif %}
  {%- endfor %}
  {%- if site.whatsapp %}
  <li><a href="https://wa.me/{{ site.whatsapp | replace(r/[^0-9]/g, '') }}" rel="noopener noreferrer" target="_blank" aria-label="WhatsApp (nouvel onglet)">{{ icone("whatsapp") | safe }}<span>WhatsApp</span></a></li>
  {%- endif %}
</ul>
